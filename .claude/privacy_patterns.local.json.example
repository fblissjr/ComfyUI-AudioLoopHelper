{
  "_comment": "EXAMPLE template. path-privacy: skip-file — this template necessarily contains placeholder paths. Copy to privacy_patterns.local.json and edit for your private paths/usernames. The .local.json variant is gitignored. Loaded by .claude/hooks/privacy_guard.py at run time.",
  "_format": "Each leak_patterns entry: {pattern: <python regex>, replacement: <suggested public form>, note: <why it leaks>}. Each scrub_replacements entry: {from: <literal substring>, to: <placeholder>}. scrub_replacements is consumed by the scrub-for-public skill; it must be ordered longest-first so specific paths replace before more general ones.",
  "leak_patterns": [
    {
      "pattern": "/home/<your-username>\\b",
      "replacement": "<comfyui> or ${CLAUDE_PROJECT_DIR}",
      "note": "absolute private home path"
    },
    {
      "pattern": "~/ComfyUI\\b",
      "replacement": "<comfyui>",
      "note": "tilde-form ComfyUI install path"
    },
    {
      "pattern": "\\b<your-username>\\b",
      "replacement": "<user> or remove",
      "note": "bare username — word-boundary so 'Real Name' in LICENSE copyright does not match"
    }
  ],
  "scrub_replacements": [
    {"from": "/home/<your-username>/ComfyUI/custom_nodes/ComfyUI-AudioLoopHelper", "to": "<pipeline_dir>"},
    {"from": "/home/<your-username>/ComfyUI/models/", "to": "<comfyui_models>/"},
    {"from": "/home/<your-username>/ComfyUI/", "to": "<comfyui>/"},
    {"from": "/home/<your-username>/", "to": "<home>/"},
    {"from": "~/ComfyUI/models/", "to": "<comfyui_models>/"},
    {"from": "~/ComfyUI/", "to": "<comfyui>/"}
  ]
}
